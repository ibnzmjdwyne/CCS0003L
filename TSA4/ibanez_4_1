#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

int main() {
    // Input
    double a, b , c;
    

    // Result
    cout << "Enter the value of a: ";
    cin >> a;
    cout << "Enter the value of b: " ;
    cin >> b;
     
    // Process
    c = sqrt((pow(a,2)) + (pow (b,2)));
    
    cout << fixed << setprecision(2);
    cout << "Hypotenuse: " << c << endl;

    
    return 0;
    
}
