#include <iostream>
using namespace std;

int main() 
{
    int n, digits;

    cout << "Enter a number (Maximum of Four Digits): ";
    cin >> n;

    if (n > 0){
        cout << "It is a positive number.";
        if (n<10){
            digits = 1;
        }else if (n<100){
            digits = 2;
        }else if (n<1000){
            digits = 3;
        }else{
            digits = 4;
        }if (n > 9999) {
             cout << "\nMaximum of four digits only!";
             return 0;
        }
        
        if (digits>1){
            cout << "\nIt has " << digits << " digits.";
        }else
        cout << "\nIt has " << digits << " digit.";
    }else if (n<0 || n==0){ 
        cout << "It is a non-positive number";
    }
    return 0;
}
